<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Core -->
    <key>CFBundleDevelopmentRegion</key>               <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>                      <string>MyApp</string>
    <key>CFBundleExecutable</key>                       <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>                       <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>            <string>6.0</string>
    <key>CFBundleName</key>                             <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>                      <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>               <string>1.0.0</string>
    <key>CFBundleVersion</key>                          <string>1</string>
    <key>LSRequiresIPhoneOS</key>                       <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>                          <string></string>
        <key>UIImageName</key>                          <string></string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Privacy strings (add ONLY the ones you use) -->
    <key>NSCameraUsageDescription</key>                 <string>MyApp uses the camera to scan QR codes.</string>
    <key>NSPhotoLibraryUsageDescription</key>           <string>MyApp needs access to your photo library to attach images.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>        <string>MyApp saves captured photos to your library.</string>
    <key>NSMicrophoneUsageDescription</key>             <string>MyApp uses the microphone for voice messages.</string>
    <key>NSLocationWhenInUseUsageDescription</key>      <string>MyApp shows nearby items based on your location.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key> <string>MyApp provides location-based reminders in the background.</string>
    <key>NSContactsUsageDescription</key>               <string>MyApp helps you find friends already on the service.</string>
    <key>NSCalendarsUsageDescription</key>              <string>MyApp adds events to your calendar.</string>
    <key>NSRemindersUsageDescription</key>              <string>MyApp syncs with your reminders.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>        <string>MyApp connects to nearby BLE accessories.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>    <string>MyApp connects to nearby BLE accessories.</string>
    <key>NSHealthShareUsageDescription</key>            <string>MyApp reads your health data to track activity.</string>
    <key>NSHealthUpdateUsageDescription</key>           <string>MyApp logs your workouts to Apple Health.</string>
    <key>NSMotionUsageDescription</key>                 <string>MyApp uses motion data to count your steps.</string>
    <key>NSSpeechRecognitionUsageDescription</key>      <string>MyApp uses speech recognition for voice input.</string>
    <key>NSAppleMusicUsageDescription</key>             <string>MyApp plays music from your library.</string>
    <key>NSUserTrackingUsageDescription</key>           <string>MyApp personalises content based on your activity.</string>

    <!-- Networking -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>               <false/>
        <key>NSAllowsLocalNetworking</key>              <true/>
    </dict>

    <!-- Background modes (only the ones you use) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
        <string>processing</string>
    </array>

    <!-- BGTaskScheduler -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.example.myapp.refresh</string>
        <string>com.example.myapp.process</string>
    </array>

    <!-- Universal Links -->
    <key>Associated Domains</key>
    <array>
        <string>applinks:myapp.example.com</string>
    </array>

    <!-- URL scheme (custom) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>                  <string>com.example.myapp</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>myapp</string>
            </array>
        </dict>
    </array>

    <!-- Capabilities / entitlements (Sign in with Apple, Associated Domains)
         belong in the app's .entitlements file, not Info.plist. -->

    <!-- App icons -->
    <key>XSAppIconAssetsPath</key>                       <string>Assets.xcassets/AppIcon.appiconset</string>

    <!-- Localization -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
    </array>

    <!-- App categories -->
    <key>LSApplicationCategoryType</key>                <string>public.app-category.productivity</string>
</dict>
</plist>
