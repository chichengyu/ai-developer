<Window x:Class="MsixSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSIX sample" Width="360" Height="200">
    <StackPanel Margin="12">
        <TextBlock Text="This app is packaged as MSIX."
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="VersionText" FontWeight="Bold"/>
        <TextBlock x:Name="PackageText" Margin="0,4,0,0"/>
    </StackPanel>
</Window>
