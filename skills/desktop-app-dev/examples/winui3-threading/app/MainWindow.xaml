<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUIThreadingDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinUI 3 BackgroundTask demo">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="StatusText" Text="idle" />
        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Width="360" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="StartButton" Content="Start 3s job" Click="OnStart" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>