<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 10/11 DPI manifest snippets.

  Per-monitor V2 awareness is the correct choice for any app that may run
  on a multi-monitor setup with mixed DPI. It fixes blurry text, wrong
  mouse coordinates, and WM_DPICHANGED handling. Drop the matching block
  into your existing app.manifest file.

  V1 (system DPI only): ok for single-monitor kiosk / locked apps.
  V2 (per-monitor V2): default for any general-purpose desktop app.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity version="1.0.0.0" name="MyApp.app" />

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>

      <!-- Per-monitor V2 (recommended) -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/manifest/windowssettings">PerMonitorV2</dpiAwareness>
      <dpiAware    xmlns="http://schemas.microsoft.com/SMI/2005/manifest/windowssettings">true/PM</dpiAware>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/manifest/windowssettings">true</longPathAware>

    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 11 (treated as Win10 for compat; no separate Win11 GUID) -->
    </application>
  </compatibility>
</assembly>
