<Window x:Class="WpfThreadingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BackgroundTask demo" Width="420" Height="200">
    <StackPanel Margin="12">
        <TextBlock x:Name="StatusText" Text="idle" Margin="0,0,0,8"/>
        <ProgressBar x:Name="ProgressBar" Height="20" Minimum="0" Maximum="100"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="StartButton" Content="Start 3s job" Click="OnStart" Width="100" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
